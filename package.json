{
  "name": "@npm_xiyuan/image-forge-mcp",
  "version": "0.2.2",
  "description": "MCP server for Pollinations free-tier image/text generation, transparent assets, background removal, and Real-ESRGAN enhancement",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/jiyi1990118/image-forge-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiyi1990118/image-forge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jiyi1990118/image-forge-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "image-forge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
