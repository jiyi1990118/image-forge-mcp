    "game-assets",
    "image-upscaling",
    "super-resolution",
    "model-context-protocol"
  ],
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "extract-zip": "^2.0.1",
    "imagemin": "^9.0.1",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-zopfli": "^7.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
