# image-forge-mcp environment configuration
# Copy to .env and adjust as needed. All variables are optional.

# --- Output ---
# Directory where generated images are saved.
OUTPUT_DIR=./vision-output

# --- Image generation ---
# Default image model (use listImageModels to see options).
IMAGE_MODEL=qwen-image
# Requested width/height in pixels. Free tier downsamples to 768px max;
# final output is upscaled locally by Real-ESRGAN or sharp.
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
# Auto-compress prompts with the free LLM API before generation.
IMAGE_AUTO_OPTIMIZE=true
# Prompt optimization style: auto|realistic|anime|painting|scifi|portrait
IMAGE_OPTIMIZE_STYLE=auto
# Pollinations LLM enhance flag. HARMFUL on free tier — keep false.
IMAGE_ENHANCE=false
# Content filtering. Default false.
IMAGE_SAFE=false

# --- Text (prompt optimization) ---
TEXT_MODEL=openai-fast
TEXT_TEMPERATURE=0.7
TEXT_TOP_P=0.9

# --- Debug ---
# true enables debug-level logs (stderr only).
DEBUG=false

# --- Neural denoise (optional) ---
# Path to a DnCNN-style ONNX model. Without it, denoiseMethod=neural
# silently falls back to median.
DENOISE_MODEL_PATH=

# --- Real-ESRGAN (optional) ---
# Use an existing binary instead of auto-downloading.
REALESRGAN_PATH=
# Override the download cache location (default: .cache/realesrgan/<tag>/).
REALESRGAN_CACHE_DIR=
# Override the download base URL (mirror/proxy).
REALESRGAN_DOWNLOAD_BASE_URL=
# Availability re-probe interval in ms when Real-ESRGAN is unavailable (default 300000).
REALESRGAN_RECHECK_MS=300000

# --- Background removal (optional) ---
# Timeout in ms for the ONNX background-removal call (default 300000).
# First run downloads ~170MB model; raise if downloads are slow.
BG_REMOVAL_TIMEOUT_MS=300000